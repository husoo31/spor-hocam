# ---- Zorunlu ----
# Ana davet kodu: kayıt olurken istenir. Uzun ve tahmin edilmesi zor bir şey yaz.
# Siteye İLK kayıt olan hesap otomatik yönetici olur; bu yüzden yayınladıktan hemen sonra ilk hesabı sen aç.
# Sonrasında yönetici panelinden kişiye özel, süreli, tek kullanımlık davet kodları da üretebilirsin.
INVITE_CODE=buraya-uzun-bir-kod-yaz

# ---- Yapay zekâ (ikisinden en az biri) ----
# Ücretsiz anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# İsteğe bağlı yedek sağlayıcı: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# İsteğe bağlı: NVIDIA (build.nvidia.com) üzerinden DeepSeek. Metin modeli: fotoğraflı isteklerde atlanır, ilk cevap ~1 dk sürebilir (yedek olarak zincirin sonuna koy).
# Anahtar: https://build.nvidia.com  -  zincire örnek: nvidia:deepseek-ai/deepseek-v4.1-flash
NVIDIA_API_KEY=
# İsteğe bağlı yedek sağlayıcılar (OpenAI uyumlu; ücretsiz katmanları var). Zincire örnek: groq:llama-3.3-70b-versatile, cerebras:llama-3.3-70b, mistral:mistral-small-latest
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# ---- Referans besin veritabanı (ücretsiz) ----
# USDA FoodData Central: genel besinler için gerçek laboratuvar değerleri (vitamin/mineral dahil).
# Ücretsiz anahtar: https://fdc.nal.usda.gov/api-guide.html (veya https://api.data.gov/signup/)
# Hızlı deneme için DEMO_KEY yazılabilir ama çok düşük limitlidir. Boş bırakırsan USDA araması kapalı kalır.
USDA_API_KEY=
# Open Food Facts (paketli ürün, barkod) anahtar istemez; nezaket gereği iletişim bilgini yaz (e-posta ya da site):
OFF_CONTACT=senin-epostan@ornek.com

# Model zinciri: soldan sağa denenir, ilki hata verirse (kota dolarsa) sıradakine geçilir.
# Biçim: sağlayıcı:model  (virgülle ayır). Model adlarını Google'ın listesinden doğrula:
#   python test_models.py --key ANAHTAR --list
AI_CHAIN=gemini:gemini-3.1-flash-lite,gemini:gemini-3.5-flash-lite,gemini:gemini-3.5-flash,groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b,openrouter:openrouter/free
# Koç yorumu gibi uzun işler için ayrı zincir (boşsa AI_CHAIN kullanılır):
#AI_CHAIN_COMPLEX=gemini:gemini-3-flash-preview
# Örnek: Gemini bitince OpenRouter'daki ücretsiz bir modele düş:
#AI_CHAIN=gemini:gemini-3-flash-preview,gemini:gemini-2.5-flash-lite,openrouter:MODEL_ADI:free

# ---- İsteğe bağlı (varsayılanlar parantez içinde) ----
# Bu üç değer ve kayıt modu, yönetici panelinden (Ayarlar → Yönetim → Sistem) değiştirilince panel değeri geçerli olur.
#AI_DAILY_LIMIT_PER_USER=80     # kişi başı günlük yapay zekâ çağrısı
#AI_DAILY_LIMIT_GLOBAL=300      # herkes için günlük toplam
#MAX_USERS=10                   # en fazla kaç hesap
#OPEN_REGISTRATION=false        # true: davet kodsuz herkes kayıt olabilir (önerilmez)
#AI_TZ=Europe/Istanbul          # günlük limitin sıfırlanacağı saat dilimi
#BACKUP_KEEP_START=5            # güncelleme anında (şema değişikliğinden önce) alınan yedeklerden kaç tane tutulsun
#ALLOW_EPHEMERAL_DATA=false     # true: /data kalıcı volume olmasa da başla (veriler her güncellemede silinir; önerilmez)
